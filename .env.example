# Copiar a .env y completar. Nunca commitear .env (ya está en .gitignore).
# Valores de ejemplo para desarrollo local con `supabase start` (ver supabase/config.toml).

# --- Supabase ---
# Local: los valores de abajo son los que imprime `supabase start`.
# Producción: Project Settings > API en el dashboard de Supabase.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=
# Server-only — jamás debe llegar al bundle del cliente (constitución §2).
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (captcha, US2/FR-013) ---
# Local: usar las site/secret keys de prueba públicas de Cloudflare (siempre pasan):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Producción: sitekey/secret real del dashboard de Cloudflare Turnstile.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- SMTP (Nodemailer — invitaciones y notificaciones propias, ver research.md R6) ---
# Local: apunta al Inbucket de `supabase start` (smtp_port en supabase/config.toml) — no
# requiere credenciales reales, captura los correos para verlos en la Inbucket URL.
# Producción: credenciales SMTP de Resend (smtp.resend.com).
SMTP_HOST=127.0.0.1
SMTP_PORT=54425
SMTP_USER=
SMTP_PASSWORD=

# --- Alertas (Feature 012 — job diario, ver research.md R2 de specs/012-alertas-dashboard/) ---
# Secreto compartido entre la Edge Function `generar-alertas` y el endpoint interno
# `server/api/alertas/notificar.post.ts` — distinto de SUPABASE_SERVICE_ROLE_KEY. Generar un
# valor propio por entorno (ej. `openssl rand -hex 32`), nunca commitear el real.
ALERTAS_CRON_SECRET=
# URL del propio servidor Nitro, tal como la Edge Function la alcanza. Local: el runtime de Edge
# Functions corre en un contenedor Docker aparte de `yarn dev` (que corre en el host) —
# `host.docker.internal` es el nombre especial que Docker Desktop resuelve al host.
# Producción: la URL real del despliegue (ej. https://app.tudominio.com/api/alertas/notificar).
ALERTAS_NOTIFICAR_URL=http://host.docker.internal:3030/api/alertas/notificar
